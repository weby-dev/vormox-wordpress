{
    "name": "weby-dev/cloud-vm-manager",
    "description": "Sell, provision and manage cloud virtual machines directly from WordPress using WooCommerce.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.9",
        "phpcompatibility/php-compatibility": "^9.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "CloudVmManager\\": "includes/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "lint": "find includes templates -name '*.php' -print0 | xargs -0 -n1 -P4 php -l",
        "compat": "phpcs -p includes cloud-vm-manager.php uninstall.php --standard=PHPCompatibility --runtime-set testVersion 7.4-"
    }
}
